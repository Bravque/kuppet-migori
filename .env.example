# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=kuppet_migori

# JWT (admin)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# JWT (member portal — must differ from JWT_SECRET)
JWT_MEMBER_SECRET=member_secret_change_in_production
JWT_MEMBER_EXPIRES_IN=30d

# Email (SMTP) — Hostinger mailbox for info@kuppetmigori.co.ke
# (hPanel -> Emails shows the exact host; smtp.hostinger.com is the usual one)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@kuppetmigori.co.ke
SMTP_PASS=your_mailbox_password_here
# Inbox that receives a notification on every new contact-form enquiry
# (reply-to is set to the enquirer). Falls back to SMTP_USER if unset.
CONTACT_EMAIL=info@kuppetmigori.co.ke
# Inbox that receives advocacy issue reports (Advocacy Desk "Report a Workplace
# Issue" form, category=advocacy). Defaults to advocacy@kuppetmigori.co.ke if unset.
ADVOCACY_EMAIL=advocacy@kuppetmigori.co.ke
# OPTIONAL — the advocacy mailbox's OWN SMTP login. Set BOTH to have advocacy
# replies sent authenticated as (and genuinely From) advocacy@. Without them,
# advocacy replies still send, but From the main account branded "Advocacy Desk"
# with Reply-To advocacy@ (the mail server rejects a From it isn't logged in as).
# Host/port default to SMTP_HOST/SMTP_PORT if you omit them.
# ADVOCACY_SMTP_USER=advocacy@kuppetmigori.co.ke
# ADVOCACY_SMTP_PASS=the_advocacy_mailbox_password
# ADVOCACY_SMTP_HOST=smtp.hostinger.com
# ADVOCACY_SMTP_PORT=465
# Inbox that receives throttled server-error alerts (500s / crashes).
# Falls back to CONTACT_EMAIL, then SMTP_USER, if unset.
ALERT_EMAIL=info@kuppetmigori.co.ke

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Public site URL — used to build links in emails (e.g. password reset)
APP_URL=https://kuppetmigori.co.ke

# Frontend URL (for CORS) — REQUIRED in production (server refuses to boot without it)
FRONTEND_URL=http://localhost:3000

# Persistent upload directory — set on hosts that wipe untracked files on deploy
# (e.g. Hostinger GitHub auto-deploy). Use an ABSOLUTE path OUTSIDE the deployed
# tree so leader photos / news images / member documents survive redeploys.
# Leave unset locally to use ./public/uploads.
# Example (Hostinger): UPLOAD_DIR=/home/u735599564/uploads
# UPLOAD_DIR=

# OPTIONAL — max scholarship-application submissions per IP per 15 min (anti-abuse
# throttle during an application rush). Default 30. Raise it if many members share
# one public IP (e.g. a large school) and legitimately hit the cap.
# SCH_APPLY_RATE_MAX=30

# OPTIONAL — MySQL connection-pool size (default 15). Keep pool_size × Passenger
# worker_count under the DB user's max_user_connections (75 on Hostinger Business).
# Only raise it if you know how many Node processes Passenger runs. 15 is safe.
# DB_POOL_LIMIT=15

# TalkSasa SMS
TALKSASA_API_KEY=your_talksasa_api_key
TALKSASA_SENDER_ID=TALKSASA
TALKSASA_BASE_URL=https://bulksms.talksasa.com/api/v3/
# Shared secret for the SMS delivery webhook. If set, TalkSasa must call
# .../api/sms/webhook?token=<secret> (or send an x-webhook-secret header) or the
# callback is rejected 401. Leave unset to keep the webhook open (not recommended).
SMS_WEBHOOK_SECRET=

# Login security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30

# Admin 2FA — TOTP secret encryption key. MUST be 64 random hex chars (32 bytes).
# Generate with: openssl rand -hex 32
# The server refuses to boot if this is missing, all-zero, or not 64 hex chars.
TOTP_ENCRYPTION_KEY=
TOTP_APP_NAME=KUPPET Migori Admin
